<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="alvina_pos_comprobantes.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]/div[1]" position="after">
            <button class="btn btn-primary btn-lg w-100 py-3 alvina-document-button" t-on-click="alvinaOpenDocument">
                <i class="fa fa-file-text-o me-2"/>boleta/factura
            </button>
        </xpath>
    </t>
</templates>
