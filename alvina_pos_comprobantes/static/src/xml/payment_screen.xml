<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="alvina_pos_comprobantes.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <!-- Preserve the subtree targeted by alvinha_point_of_sale inheritance.
             Fiscal identity is requested only from the paid order's receipt. -->
        <xpath expr="//button[hasclass('js_invoice')]" position="attributes">
            <attribute name="t-if">pos.company.country_id?.code !== 'PE' || currentOrder.isRefund || currentOrder.priceIncl &lt;= 0</attribute>
        </xpath>
    </t>
</templates>
